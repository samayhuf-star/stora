{
  "name": "@stora-sh/db",
  "version": "0.1.0",
  "description": "Stora Cloud data layer - Drizzle schema, migrations and repositories (Postgres, or embedded PGlite for zero-setup dev)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" }
  },
  "files": ["dist"],
  "scripts": {
    "generate": "drizzle-kit generate && node scripts/gen-migrations.mjs",
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.3.0",
    "drizzle-orm": "^0.45.0",
    "pg": "^8.13.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "drizzle-kit": "^0.31.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "license": "MIT"
}
